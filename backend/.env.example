# Copy to backend/.env (gitignored). Real environment variables win over this file.
# mock (default) or live.
VISION_MODE=mock
# Live only. Never commit a real key. Never prefix with VITE_.
MODEL_API_KEY=
# Optional overrides (defaults shown).
# META_BASE_URL=https://api.meta.ai/v1
# VISION_MODEL=muse-spark-1.3
# VISION_REASONING_EFFORT=minimal
# VISION_TIMEOUT_S=10
# MOCK_HOLD_CALLS=4
# BUDGET_USD=25
# PRICE_INPUT_PER_M=1.25
# PRICE_CACHED_INPUT_PER_M=0.15
# PRICE_OUTPUT_PER_M=4.25
# LISTEN_MODE=  (defaults to VISION_MODE; live opens the realtime ASR for "Hey Eyes" questions)
# META_ASR_URL=wss://api.meta.ai/v1/asr/realtime
# ASR_MODEL=muse-voice-transcribe-1.0
# ASR_PRICE_PER_HOUR=0.18
